# Twitch Data Ingestion Service - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==============================================================================
# Twitch API Credentials
# ==============================================================================
# Get these from: https://dev.twitch.tv/console/apps
# 1. Create a new application
# 2. Copy the Client ID and generate a Client Secret

TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# User Access Token (required for EventSub and IRC)
# Generate using Twitch CLI or OAuth flow:
#   twitch token -u -s "user:read:email"
# Or use: https://twitchtokengenerator.com/ (select "User Access Token")
TWITCH_ACCESS_TOKEN=your_user_access_token_here

# ==============================================================================
# Database Configuration
# ==============================================================================
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
# Get from: https://console.neon.tech/ → Your Project → Connection Details

DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# ==============================================================================
# Application Settings
# ==============================================================================

# Comma-separated list of Twitch usernames to track
# Example: TRACKED_STREAMERS=streamer1,streamer2,streamer3
# Note: These will be auto-created in the database if they don't exist
TRACKED_STREAMERS=

# Snapshot collection interval in minutes (default: 15)
# Must be a divisor of 60 for clean scheduling (e.g., 5, 10, 15, 20, 30)
SNAPSHOT_INTERVAL_MINUTES=15

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
